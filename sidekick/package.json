{
  "name": "sidekick",
  "version": "1.1.0",
  "description": "Sidekick project management status and ESP display companion",
  "main": "main.js",
  "author": {
    "name": "Mikkel",
    "email": "mikkeliversen09@outlook.dk"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "build:media": "python3 scripts/build-media.py",
    "build:icons": "python3 scripts/build-icons.py"
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "trp.solutions.sidekick",
    "productName": "Sidekick",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "lib/**/*",
      "*.html",
      "style.css",
      "icons/generated/**/*",
      "media/colors-idle.rgb565.gz",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "icon": "icons/generated/sidekick.png"
    },
    "win": {
      "target": "nsis",
      "icon": "icons/generated/sidekick.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "icons/generated/sidekick.png",
      "category": "Utility"
    },
    "asarUnpack": [
      "node_modules/@serialport/**/*",
      "node_modules/ffmpeg-static/**/*"
    ]
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "serialport": "^13.0.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "electron@36.9.5": true,
    "@serialport/bindings-cpp@13.0.0": true,
    "electron-winstaller@5.4.0": true
  }
}
